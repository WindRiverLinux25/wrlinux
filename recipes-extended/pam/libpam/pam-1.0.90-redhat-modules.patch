Date: Tue, 20 Apr 2021 14:17:05 +0800
Subject: [PATCH] build redhad modules

Upstream-Status: Inappropriate [configuration]

Signed-off-by: Joe Slater <jslater@windriver.com>
Signed-off-by: Wenzong Fan <wenzong.fan@windriver.com>
Signed-off-by: Chen Qi <Qi.Chen@windriver.com>

disable module pam_postgresok
Signed-off-by: Changqing Li <changqing.li@windriver.com>
---
 configure.ac        | 1 +
 modules/Makefile.am | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/configure.ac b/configure.ac
index fc5cc085..3442171b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -783,6 +783,7 @@ AC_CONFIG_FILES([Makefile libpam/Makefile libpamc/Makefile libpamc/test/Makefile
 	po/Makefile.in \
 	Make.xml.rules \
 	modules/Makefile \
+	modules/pam_chroot/Makefile modules/pam_console/Makefile \
 	modules/pam_access/Makefile \
 	modules/pam_canonicalize_user/Makefile \
 	modules/pam_debug/Makefile modules/pam_deny/Makefile \
diff --git a/modules/Makefile.am b/modules/Makefile.am
index 0d83386a..a1dae307 100644
--- a/modules/Makefile.am
+++ b/modules/Makefile.am
@@ -48,6 +48,8 @@ SUBDIRS := \
 	pam_debug \
 	pam_deny \
 	pam_echo \
+	pam_chroot \
+	pam_console \
 	pam_env \
 	pam_exec \
 	pam_faildelay \
