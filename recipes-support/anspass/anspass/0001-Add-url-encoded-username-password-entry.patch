+	}
 	/* Un-roll. */
 del_passwd_fail:
 	/* Fall-through expected */
@@ -1345,22 +1477,38 @@ del_db2_passwd_fail:
 		del_db1_entry(e_passwd);
 		e_passwd = NULL;
 	}
-
 del_user_fail:
