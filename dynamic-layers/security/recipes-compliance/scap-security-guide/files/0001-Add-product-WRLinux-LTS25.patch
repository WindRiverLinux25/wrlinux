+product: wrlinuxlts25
+full_name: Wind River Linux LTS25
+type: platform
+
+families:
+  - wrlinux
+
+major_version_ordinal: 25
+
+benchmark_id: WRLINUX-LTS25
+benchmark_root: "../../linux_os/guide"
+components_root: "../../components"
+
+profiles_root: "./profiles"
+
+pkg_manager: "dnf"
+
+init_system: "systemd"
+
+cpes_root: "../../shared/applicability"
+cpes:
+  - wrlinuxlts25:
+      name: "cpe:/o:windriver:wrlinux:lts25"
+      title: "Wind River Linux LTS25"
+      check_id: installed_OS_is_wrlinuxlts25
